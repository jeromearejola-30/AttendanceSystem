@{
    ViewData["Title"] = "About Us";
}

<!-- Header Banner -->
<div class="text-center py-4 mb-4">
    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold mb-2">Project Overview</span>
    <h1 class="display-5 fw-bold text-dark">About Our Project</h1>
    <p class="lead text-secondary mx-auto" style="max-width: 600px;">
        This Attendance Management System was built using <strong>ASP.NET Core MVC</strong> to provide a fast, secure, and modern tracking solution.
    </p>
</div>

<!-- Key Features Section -->
<div class="mb-5">
    <h4 class="fw-bold text-dark mb-4 text-center">
        <i class="bi bi-stars text-warning me-2"></i>System Features
    </h4>
    <div class="row g-3">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 text-center p-3 bg-white">
                <div class="card-body">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-person-check fs-3"></i>
                    </div>
                    <h6 class="fw-bold text-dark">Student Attendance</h6>
                    <p class="text-muted small m-0">Track and record daily student presence, delays, and absences.</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 text-center p-3 bg-white">
                <div class="card-body">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-shield-lock fs-3"></i>
                    </div>
                    <h6 class="fw-bold text-dark">Secure Login</h6>
                    <p class="text-muted small m-0">Protected portal ensuring only authorized users access system records.</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 text-center p-3 bg-white">
                <div class="card-body">
                    <div class="bg-info bg-opacity-10 text-info rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-phone fs-3"></i>
                    </div>
                    <h6 class="fw-bold text-dark">Responsive Design</h6>
                    <p class="text-muted small m-0">Optimized to look great on desktop computers, tablets, and phones.</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 text-center p-3 bg-white">
                <div class="card-body">
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-bootstrap fs-3"></i>
                    </div>
                    <h6 class="fw-bold text-dark">Bootstrap 5 UI</h6>
                    <p class="text-muted small m-0">Built using modern components and clean typography for seamless UX.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<hr class="my-5 opacity-25">

<!-- Developers Section -->
<div>
    <div class="text-center mb-4">
        <h4 class="fw-bold text-dark">
            <i class="bi bi-code-slash text-primary me-2"></i>Meet the Developers
        </h4>
        <p class="text-muted small">The team behind the development of this portal</p>
    </div>

    <div class="row g-4 justify-content-center">
        <!-- Jerome Arejola -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 bg-white h-100">
                <div class="card-body">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-person-fill fs-2"></i>
                    </div>
                    <h5 class="fw-bold text-dark m-0">Jerome Arejola</h5>
                    <span class="badge bg-light text-primary border my-2 px-3 py-1">Home & Attendance</span>
                    <p class="text-muted small m-0">Handled dashboard layout, attendance records logic, and UI integration.</p>
                </div>
            </div>
        </div>

        <!-- Ralf Arciaga -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 bg-white h-100">
                <div class="card-body">
                    <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-person-fill fs-2"></i>
                    </div>
                    <h5 class="fw-bold text-dark m-0">Ralf Arciaga</h5>
                    <span class="badge bg-light text-success border my-2 px-3 py-1">Authentication</span>
                    <p class="text-muted small m-0">Designed and implemented the user login flow and security controller.</p>
                </div>
            </div>
        </div>

        <!-- Joshua Solo -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 bg-white h-100">
                <div class="card-body">
                    <div class="bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-person-fill fs-2"></i>
                    </div>
                    <h5 class="fw-bold text-dark m-0">Joshua Solo</h5>
                    <span class="badge bg-light text-info border my-2 px-3 py-1">About & System Info</span>
                    <p class="text-muted small m-0">Structured system information, project documentation, and visual layouts.</p>
                </div>
            </div>
        </div>
    </div>
</div>