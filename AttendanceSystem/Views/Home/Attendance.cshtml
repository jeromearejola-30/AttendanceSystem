@{
    ViewData["Title"] = "Attendance";
}

<h2>Student Attendance</h2>

<table class="table table-bordered table-striped">

    <thead class="table-dark">

        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Course</th>
            <th>Status</th>
        </tr>

    </thead>

    <tbody>

        <tr>
            <td>1001</td>
            <td>Juan Dela Cruz</td>
            <td>BSIT</td>
            <td>Present</td>
        </tr>

        <tr>
            <td>1002</td>
            <td>Maria Santos</td>
            <td>BSCS</td>
            <td>Late</td>
        </tr>

        <tr>
            <td>1003</td>
            <td>Peter Cruz</td>
            <td>BSIT</td>
            <td>Absent</td>
        </tr>

    </tbody>

</table>

<hr>

<h4>Add Attendance</h4>

<form>

    <div class="mb-3">

        <label>Student ID</label>

        <input class="form-control" />

    </div>

    <div class="mb-3">

        <label>Student Name</label>

        <input class="form-control" />

    </div>

    <div class="mb-3">

        <label>Course</label>

        <input class="form-control" />

    </div>

    <div class="mb-3">

        <label>Status</label>

        <select class="form-select">

            <option>Present</option>
            <option>Late</option>
            <option>Absent</option>

        </select>

    </div>

    <button class="btn btn-success">
        Save
    </button>

</form>