@{
    ViewData["Title"] = "Dashboard";
}

<!-- Welcome Banner -->
<div class="p-4 p-md-5 mb-4 rounded-3 bg-light border">
    <div class="container-fluid py-2">
        <h1 class="display-6 fw-bold text-dark">
            <i class="bi bi-house-door text-primary me-2"></i>Welcome to Attendance Portal
        </h1>
        <p class="col-md-8 fs-5 text-muted">
            Track student attendance, view reports, and manage daily class logs seamlessly.
        </p>
        <a asp-controller="Home" asp-action="Attendance" class="btn btn-primary btn-lg fw-semibold me-2">
            <i class="bi bi-calendar-check me-2"></i>Mark Today's Attendance
        </a>
    </div>
</div>

<!-- Quick Navigation Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card h-100 border-0 shadow-sm bg-white rounded-3">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-3 me-3">
                        <i class="bi bi-clipboard-data fs-4"></i>
                    </div>
                    <h5 class="card-title fw-bold m-0">Attendance Records</h5>
                </div>
                <p class="card-text text-secondary">
                    View full attendance history, filter by date or class, and update existing student records.
                </p>
                <a asp-controller="Home" asp-action="Attendance" class="text-decoration-none fw-semibold">
                    Go to Attendance <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100 border-0 shadow-sm bg-white rounded-3">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-secondary bg-opacity-10 text-secondary p-2 rounded-3 me-3">
                        <i class="bi bi-info-circle fs-4"></i>
                    </div>
                    <h5 class="card-title fw-bold m-0">System Overview</h5>
                </div>
                <p class="card-text text-secondary">
                    Check system information, user guidelines, and general settings for this management portal.
                </p>
                <a asp-controller="Home" asp-action="About" class="text-decoration-none fw-semibold text-secondary">
                    Learn More <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Quick Info Alert Box -->
<div class="alert alert-info border-0 shadow-sm d-flex align-items-center p-3 rounded-3" role="alert">
    <i class="bi bi-lightbulb fs-4 text-info me-3"></i>
    <div>
        <strong>Tip:</strong> Make sure to submit daily attendance before 5:00 PM to ensure accurate system records.
    </div>
</div>