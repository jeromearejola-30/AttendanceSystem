@{
    ViewData["Title"] = "Home";
}

<div class="text-center mt-5">

    <h1 class="display-4">Attendance Management System</h1>

    <p class="lead">
        Welcome to the Student Attendance Management System.
    </p>

    <hr />

    <div class="mt-4">

        <a asp-controller="Home"
